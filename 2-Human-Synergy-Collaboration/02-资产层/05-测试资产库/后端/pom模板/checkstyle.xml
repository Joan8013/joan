<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  extend_platform 精简 Checkstyle 规则集（对齐编码约定，聚焦"真问题"，不做纯风格挑刺）。
  遗留库落地：先 failsOnError=false 报告模式，稳定后再逐步收紧/卡门。
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="warning"/>
    <property name="fileExtensions" value="java"/>

    <!-- 抑制文件：对存量/生成代码豁免 -->
    <module name="SuppressionFilter">
        <property name="file" value="${checkstyle.suppressions.file}"/>
        <property name="optional" value="true"/>
    </module>

    <!-- 禁止 Tab（与前端 editorconfig 2 空格风格一致，后端用空格） -->
    <module name="FileTabCharacter">
        <property name="eachLine" value="true"/>
    </module>

    <module name="TreeWalker">
        <!-- 导入卫生 -->
        <module name="UnusedImports"/>
        <module name="RedundantImport"/>
        <module name="AvoidStarImport"/>

        <!-- 真问题：空 catch（对齐"禁止空catch/吞异常"） -->
        <module name="EmptyCatchBlock">
            <property name="exceptionVariableName" value="expected|ignored"/>
        </module>

        <!-- 字符串用 == 比较（易错） -->
        <module name="StringLiteralEquality"/>

        <!-- equals/hashCode 成对 -->
        <module name="EqualsHashCode"/>

        <!-- switch 缺 default / fall through -->
        <module name="MissingSwitchDefault"/>
        <module name="FallThrough"/>

        <!-- 布尔表达式可简化 -->
        <module name="SimplifyBooleanExpression"/>
        <module name="SimplifyBooleanReturn"/>

        <!-- if/for/while 必须带花括号 -->
        <module name="NeedBraces"/>

        <!-- 禁止 System.out / System.err（用日志框架） -->
        <module name="RegexpSinglelineJava">
            <property name="format" value="System\.(out|err)\."/>
            <property name="message" value="禁止 System.out/err，请用 SLF4J 日志"/>
            <property name="ignoreComments" value="true"/>
        </module>

        <!-- 禁止 printStackTrace（异常应记日志或抛 BaseException） -->
        <module name="RegexpSinglelineJava">
            <property name="format" value="\.printStackTrace\(\)"/>
            <property name="message" value="禁止 printStackTrace，请记录日志或抛业务异常"/>
            <property name="ignoreComments" value="true"/>
        </module>

        <!-- 金额红线：禁止用 double/float 声明疑似金额字段（提示级，配合人工判断） -->
        <module name="RegexpSinglelineJava">
            <property name="format" value="(double|float)\s+\w*([Aa]mount|[Mm]oney|[Ff]ee|[Pp]rice)\w*"/>
            <property name="message" value="金额禁止用 double/float，请用 BigDecimal"/>
            <property name="ignoreComments" value="true"/>
        </module>
    </module>
</module>
