<?xml version="1.0" encoding="UTF-8"?>
<!--
  extend_platform 测试体系 — 父 POM 合并参考（Spring Boot 2.3.7 + Java 8）

  用法：将下列块合并进项目根 pom.xml，勿整文件替换现有父 POM。
  - §1 properties      → 合并进现有 <properties>
  - §2 dependencyManagement → 合并进现有 <dependencyManagement><dependencies>
  - §3 pluginManagement     → 合并进现有 <build><pluginManagement><plugins>（若无则新建）
  - §4 build plugins        → 合并进现有 <build><plugins>
  - §5 profiles             → 合并进现有 <profiles>（可选）

  对应文档：../README.md
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.etcplus</groupId>
    <artifactId>etcplus</artifactId>
    <version>1.0.4</version>
    <packaging>pom</packaging>
    <name>etcplus（测试配置参考 — 勿直接作为根 POM 使用）</name>

    <!-- §1 测试相关版本（合并进根 pom 的 properties） -->
    <properties>
        <java.version>1.8</java.version>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <testcontainers.version>1.19.3</testcontainers.version>
        <wiremock.version>2.35.1</wiremock.version>
        <jacoco.version>0.8.8</jacoco.version>
        <pitest.version>1.9.11</pitest.version>
        <pitest-junit5.version>1.1.2</pitest-junit5.version>
        <approvaltests.version>11.9.0</approvaltests.version>

        <!-- 与 Spring Boot 2.3.7 配套的 Surefire/Failsafe（JUnit 5） -->
        <maven-surefire-plugin.version>2.22.2</maven-surefire-plugin.version>
        <maven-failsafe-plugin.version>2.22.2</maven-failsafe-plugin.version>
    </properties>

    <!-- §2 测试 BOM（合并进 dependencyManagement） -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>com.github.tomakehurst</groupId>
                <artifactId>wiremock-jre8</artifactId>
                <version>${wiremock.version}</version>
            </dependency>

            <dependency>
                <groupId>com.approvaltests</groupId>
                <artifactId>approvaltests</artifactId>
                <version>${approvaltests.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <!-- §3 插件版本统一管理（子模块可省略 version） -->
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                    <configuration>
                        <includes>
                            <include>**/*Test.java</include>
                        </includes>
                        <!-- 黄金文件更新：mvn -Dgolden.update=true test -->
                        <systemPropertyVariables>
                            <golden.update>${golden.update}</golden.update>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${maven-failsafe-plugin.version}</version>
                    <configuration>
                        <includes>
                            <include>**/*IT.java</include>
                        </includes>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>
                </plugin>

                <plugin>
                    <groupId>org.pitest</groupId>
                    <artifactId>pitest-maven</artifactId>
                    <version>${pitest.version}</version>
                    <dependencies>
                        <dependency>
                            <groupId>org.pitest</groupId>
                            <artifactId>pitest-junit5-plugin</artifactId>
                            <version>${pitest-junit5.version}</version>
                        </dependency>
                    </dependencies>
                </plugin>
            </plugins>
        </pluginManagement>

        <!-- §4 默认启用的测试插件（合并进根 pom build/plugins） -->
        <plugins>
            <!-- 单元测试 *Test -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>

            <!-- 集成测试 *IT，绑定 verify -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- JaCoCo：prepare-agent + report；覆盖率门禁见 profile coverage-gate -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- §5 可选 Profile -->
    <profiles>
        <!-- 覆盖率门禁：mvn verify -Pcoverage-gate -->
        <profile>
            <id>coverage-gate</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>check</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                                <configuration>
                                    <rules>
                                        <rule>
                                            <element>BUNDLE</element>
                                            <limits>
                                                <limit>
                                                    <counter>LINE</counter>
                                                    <value>COVEREDRATIO</value>
                                                    <minimum>0.80</minimum>
                                                </limit>
                                                <limit>
                                                    <counter>BRANCH</counter>
                                                    <value>COVEREDRATIO</value>
                                                    <minimum>0.70</minimum>
                                                </limit>
                                            </limits>
                                        </rule>
                                    </rules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- 变异测试：mvn -Pmutation-test org.pitest:pitest-maven:mutationCoverage -->
        <profile>
            <id>mutation-test</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <configuration>
                            <targetClasses>
                                <param>com.etcplus.system.*.settle.*</param>
                                <param>com.etcplus.system.*.check.*</param>
                                <param>com.etcplus.system.*.transfer.*</param>
                                <param>com.etcplus.system.*.invoice.*</param>
                            </targetClasses>
                            <targetTests>
                                <param>com.etcplus.system.*</param>
                            </targetTests>
                            <mutationThreshold>70</mutationThreshold>
                            <coverageThreshold>80</coverageThreshold>
                            <timestampedReports>false</timestampedReports>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- 跳过集成测试（CI 快速路径）：mvn test -Pskip-it -->
        <profile>
            <id>skip-it</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
